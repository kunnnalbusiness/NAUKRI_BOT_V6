# ==============================================================================
# NAUKRI & LINKEDIN AUTONOMOUS BOT — PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and configure your values. DO NOT commit .env to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION & ACCESS CONTROL (MANDATORY)
# ------------------------------------------------------------------------------
# Default Administrator account credentials (used on initial boot and recovery)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Cryptographic secret key used for JWT signing and Fernet symmetric session encryption
# Minimum 32 characters required. Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_32_character_secret_key_here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# MongoDB connection string for user profiles, encrypted session storage, and activity.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT: For Render deployments, ensure 0.0.0.0/0 is added to MongoDB Atlas Network Access.
# If left empty, system automatically falls back to local JSON store in data/users_store.json
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=NAUKRI_BOT

# ------------------------------------------------------------------------------
# 3. CORS & HOST SETTINGS
# ------------------------------------------------------------------------------
# Frontend origin for CORS policy. In single-container production, leaving this as default is fine.
# If deploying frontend separately on Vercel/Netlify/Render static site, specify the URL:
# FRONTEND_URL=https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Server host and port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 4. BROWSER AUTOMATION & PLAYWRIGHT EXECUTION
# ------------------------------------------------------------------------------
# Set to 'true' for Render / Docker cloud execution (headless).
# Set to 'false' only for local desktop execution where you want to watch the real browser window.
HEADLESS=true
DATA_DIR=data

# ------------------------------------------------------------------------------
# 5. AI PROVIDER API KEYS (OPTIONAL - CAN ALSO BE CONFIGURED IN DASHBOARD)
# ------------------------------------------------------------------------------
# Google Gemini API Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq Cloud API Key: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 6. GOOGLE SHEETS LIVE JOURNAL SYNC (OPTIONAL)
# ------------------------------------------------------------------------------
# Spreadsheet browser URL
GOOGLE_SHEET_URL=
# Google Apps Script Webhook POST URL (returns JSON {"status": "success"})
GOOGLE_SHEET_WEBHOOK_URL=
